# Streamlit Community Cloud -> App settings -> Secrets
# Least-privilege rule: the public dashboard only needs DATABASE_URL.
# Do NOT place SUPABASE_SERVICE_ROLE_KEY here; keep that GitHub-Actions-only for ingestion/raw archive.
DATABASE_URL = ""

# Optional AI. Keep disabled until you intentionally enable paid API calls.
AI_ENABLED = "0"
OPENAI_API_KEY = ""
AI_MODEL = "gpt-5.6-luna"
AI_DAILY_CALL_LIMIT = "20"
AI_MAX_INPUT_CHARS = "12000"
AI_INVESTIGATION_MAX_OUTPUT_TOKENS = "450"
AI_DISCLOSURE_MAX_OUTPUT_TOKENS = "220"
AI_REASONING_EFFORT = "none"
AI_INPUT_USD_PER_MTOK = "0"
AI_CACHED_INPUT_USD_PER_MTOK = "0"
AI_OUTPUT_USD_PER_MTOK = "0"
