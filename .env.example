# ============================================================
# Local development
# ============================================================
LOCAL_DB_PATH=data/local/surveillance.db
APP_DATA_MODE=LIVE

# ============================================================
# Cloud database (Supabase PostgreSQL)
# Leave blank for local SQLite. Prefer the Supabase Session Pooler
# connection string for GitHub Actions / Streamlit Cloud.
# ============================================================
DATABASE_URL=

# Optional persistent raw HTML archive in Supabase Storage.
# Configure both URL + service-role key, or leave both blank for local raw files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_BUCKET=raw-market-data

# ============================================================
# Optional OpenAI enrichment — paid calls are OFF by default.
# ChatGPT Plus does NOT fund API usage; API billing is separate.
# ============================================================
AI_ENABLED=0
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_DAILY_CALL_LIMIT=20
AI_MAX_INPUT_CHARS=12000
AI_INVESTIGATION_MAX_OUTPUT_TOKENS=450
AI_DISCLOSURE_MAX_OUTPUT_TOKENS=220
AI_REASONING_EFFORT=none

# Optional token-price inputs for local cost estimation.
# Leave 0 to log token usage without estimating cost.
AI_INPUT_USD_PER_MTOK=0
AI_CACHED_INPUT_USD_PER_MTOK=0
AI_OUTPUT_USD_PER_MTOK=0
